# --- Server -----------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# --- Admin API (x-admin-key header). Use a long random value, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Persistence: "memory" (zero-setup demo) or "postgres" (RLS-enforced) ----
PERSISTENCE=memory
# The app must connect as the NON-superuser role created in db/migrations/000_roles.sh,
# otherwise Row-Level Security is bypassed.
DATABASE_URL=postgres://gateway_app:gateway_app_dev_password@localhost:5432/llm_gateway
POSTGRES_PASSWORD=postgres_dev_password
APP_DB_PASSWORD=gateway_app_dev_password

# --- LLM providers (leave empty to disable a provider) ----------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# e.g. http://localhost:11434 (or http://host.docker.internal:11434 from docker compose)
OLLAMA_BASE_URL=
# Deterministic offline provider used by the quickstart and tests.
ENABLE_MOCK_PROVIDER=true
PROVIDER_TIMEOUT_MS=60000

# --- Resilience -------------------------------------------------------------
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=30000

# --- Semantic cache ---------------------------------------------------------
CACHE_SIMILARITY_THRESHOLD=0.9
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES_PER_TENANT=500
