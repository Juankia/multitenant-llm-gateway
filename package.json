{
  "name": "multitenant-llm-gateway",
  "version": "0.1.0",
  "description": "Multi-tenant LLM gateway for B2B chatbots: provider fallback, circuit breaking, FinOps budgets, semantic cache and Postgres Row-Level Security.",
  "author": "Juan Carlos Amay",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "js-tiktoken": "^1.0.20",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
